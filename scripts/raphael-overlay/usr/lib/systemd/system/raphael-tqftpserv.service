[Unit]
Description=Qualcomm TFTP service (serves modem firmware requests to the AP)
Documentation=man:tqftpserv(1)
After=raphael-qrtr-ns.service
Before=raphael-modem.service
Requires=raphael-qrtr-ns.service

[Service]
Type=simple
# modem 通过 TFTP 向 AP 要自己的运行时文件；tqftpserv 把请求映射到
# /readonly/firmware/image 与 /readwrite 两个根（Android 里是 vendor 分区和 data）。
# 实测它要的是 wlanmdsp.mbn 和 modem_pr/mcfg/configs/mcfg_{hw,sw}/mbn_*.dig，
# 少一个 modem 就每 0.5 秒 fatal error 崩一次（crash #352 之前一直这样）。
ExecStartPre=/bin/sh -c 'mkdir -p /readonly/firmware /readwrite; ln -sfn /lib/firmware/qcom/sm8150/Xiaomi/raphael /readonly/firmware/image'
ExecStart=/opt/raphael/qcom/bin/tqftpserv
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
