# SM8150 / raphael 在 kernel-common/steamos.config 之上的增量。
#
# 这份文件只放“内核树里没有、而我们的启动方式和别人的不一样”所需要的开关。
# 面板（EA8076）、触摸（GT9886）、音频（WCD9340 + TFA9874）已经在设备树自带的
# config 片段里，不要在这里重复。

# --- 阶段 1 的日志通道 -----------------------------------------------------
#
# 这台机器没有能从外面接的调试串口：DTS 的 stdout-path 是 uart2（ttyMSM0），
# 那是主板测试点上的 UART，不是 USB。所以阶段 1（没有 rootfs、没有 journal）
# 能看的通道只有两个，两个都要有：
#
#   1. 面板上的 fbcon（下面这两项 + dts/ 里的 framebuffer append）
#   2. kernel-common/initramfs/init 拉起的 USB gadget：acm.usb0 + ncm.usb0
#      和一个 172.16.42.1:23 的 shell，前提是 steamos.usbshell=1 在 cmdline 上
#
# 第 1 条是"看到崩溃"的唯一手段：内核如果死在 USB 起来之前，第 2 条什么都不给。
# simpledrm 接管 ABL 留下的 splash framebuffer，代价是 msm 的显示驱动绑不上 ——
# 阶段 1 不需要后者。
CONFIG_DRM_SIMPLEDRM=y

# ACM 不在 defconfig 里：USB_CONFIGFS 是 y，但里面的 function 要单独选。
# U_SERIAL_CONSOLE 只有在 USB_U_SERIAL 打开后才出现，而 ACM select 它 ——
# 不在这里显式写 y，它在 .config 里根本不会出现（alioth 那边就是这么发现的）。
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_U_SERIAL_CONSOLE=y

# --- 阶段 2 之前就要准备的 -------------------------------------------------
#
# 触摸是 =m（设备树的片段这么定的，固件和校准要从 rootfs 读），阶段 1 用不到、
# 阶段 2 由 udev 加载。这里只留一条：它挂在 QUPv3 的 i2c19 上，而 GENI 的
# i2c 控制器必须和它同层可用 —— 设备树已经 enable 了三个 wrapper，驱动是
# defconfig 里的 =y，不用动。
#
# 麦克风/耳机那两条 SLIMbus DAI link 是参考项目踩过的坑（枚举失败会让整块
# 声卡卡在 EPROBE_DEFER，一个 /dev/snd 都没有）。我们第一版先不动设备树：
# 那是阶段 2 的事，而且他们删掉 link 的代价是永久失去耳机通路，这个取舍要在
# 真机上确认之后再决定，不在没有画面的阶段 1 里先斩后奏。

# --- 崩溃日志（阶段 1 唯一的死因来源）---------------------------------------
#
# 这台机器没有可外接的串口，USB gadget 又可能正好是坏掉的那一环 —— 内核如果在
# 跑到 userspace 之前死掉，除了"屏幕黑着"之外没有任何信息。ramoops 把 panic
# 直接写进一块 DRAM，而那块 DRAM 的地址和布局是抄原厂内核的（见 dts/ 里的
# ramoops@b0000000），所以重启进 Android 之后，原厂内核会把它读成
# /sys/fs/pstore/console-ramoops-0。
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# --- 阶段 1 的嘴：命令行交给引导器 ------------------------------------------
#
# 内建 cmdline 原本是 "quiet loglevel=0 ..."（给正式启动用的）。配上
# CONFIG_CMDLINE_FORCE=y 之后，引导器传什么都会被丢掉 —— 内核即使活着也一个字
# 不打。这台机器没有串口，面板是唯一的眼睛，所以：

# 注意一：build.sh 的片段合并只认 NAME=value，跳过 # 开头的行，必须写 =n。
# 注意二：这三个在 Kconfig 里是 choice（三选一）。只写两个 =n 会把 choice 清成
# 非法的「全空」，olddefconfig 会回填 FORCE=y，等于没改。要换方向就得把目标
# 成员写成 y —— 这里选 FROM_BOOTLOADER：有引导器参数就用引导器的，没有才退到
# CONFIG_CMDLINE。这样改命令行只要重打 boot 镜像，不用重编内核。
CONFIG_CMDLINE_FROM_BOOTLOADER=y
CONFIG_CMDLINE_FORCE=n
CONFIG_CMDLINE_EXTEND=n
CONFIG_CMDLINE="console=tty0 loglevel=7"

# --- 存储：仍以模块形式提供，**不要**编进内核 --------------------------------
#
# 第一次进到 userspace（COM4 上的 root shell 亲眼看到的）：/proc/partitions 是空的，
# root mount failed 的根源 —— 这两条在 defconfig 里是 =m，而 boot 镜像只带内核
# 不带模块，手机等于没有存储。
#
# 试过把它们改成 =y：**内核在显示初始化之前就死了**（屏幕全黑、USB 上什么都不出现，
# 连 gadget 都来不及起）。固件/时钟/PHY 的时序问题在 early probe 里炸，而这个阶段
# 还没有任何控制台可以说话。
#
# 所以正确做法是「模块 + initramfs 里 insmod」：控制台先立起来，再加载 UFS，
# 出问题能看见。见 docs/raphael.md §13。
#
# 这里不需要写任何东西：树里那份 defconfig 本来就是 =m，而本文件的片段加载器
# 只认 NAME=value、会跳过 # 开头的行 —— 写 "# CONFIG_X is not set" 是无效的，
# 写 =n 又会把模块关掉。保持沉默才是「用 =m」。

# --- quota：Android 的 userdata 是开了 quota 的 ext4 -------------------------
#
# 挂载 sda31（LABEL="data"）时内核报
#   EXT4-fs (sda31): The kernel was not built with CONFIG_QUOTA and CONFIG_QFMT_V2
# 然后 mount 返回 EINVAL。不是存储没通，是文件系统特性不认识。
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y

# --- InputPlumber：虚拟手柄需要 UHID -----------------------------------------
#
# 音量键要变成 Steam 键 / 快捷菜单，唯一的路是 InputPlumber 造一个虚拟 Steam
# Deck 手柄（`deck-uhid` target），因为 Steam 只认手柄的 Guide / QuickAccess
# 按钮，键盘上没有等价物。
#
# 2026-11-08 首次上机：配置全对（InputPlumber 日志里明确
# "Found a matching input device evdev://event0"，也建了 CompositeDevice），
# 但紧接着每个源设备都失败：
#   Error adding device 'gpio-keys (event0)': Could not read: No such file or directory
# 根因是 /dev/uhid 不存在 —— /proc/config.gz 里：
#   # CONFIG_UHID is not set
#   # CONFIG_INPUT_UINPUT is not set
# 树里那份 defconfig 没开这两项，olddefconfig 也不会替你开。
#
# 两个都用 =y 而不是 =m：各几十 KB，而 =m 还要考虑「谁在 InputPlumber 之前
# 加载它」—— udev 的模块自动加载在 multi-user 之后，靠不住，又得往 initramfs
# 里塞一趟。直接编进去最省事，也不影响前面 UFS 那条「必须 =m」的结论
# （那是早期 probe 时序问题，UHID 是纯软件设备，没有 probe 风险）。
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
