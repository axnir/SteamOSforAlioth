/*
 * 阶段 1 的观测通道：把 ABL 的 splash framebuffer 交给 simpledrm。
 *
 * 为什么需要它：这台机器没有能从外面接的调试串口（DTS 的 stdout-path 是测试点
 * 上的 uart2），USB gadget 要等内核跑到 initramfs 才有，而内核如果死在更早的
 * 地方，两边都是"什么都没有"—— 分不清是没跳转、跳了但崩了、还是崩在了哪一步。
 *
 * 地址和规格不是猜的：framebuffer 是原厂设备树里的 `cont_splash_region@9c000000`，
 * 1080×2340、stride 4320 = 1080×4，所以是 32 位像素。区域大小 0x2400000 也是从
 * 原厂 DTB 里读出来的（我们需要的 0x9a3f80 装得下）。
 *
 * **那块内存必须 `no-map` 预留**。alioth 那边踩过：不预留，内核会把同一段内存
 * 分给别人，而 simplefb 直接往里写 —— 表现是随机内存损坏，屏幕上先花屏再黑屏，
 * 和"没输出"完全不像同一个 bug。预留但不 no-map 也不行：那段内存同时在
 * cacheable 线性映射里，而 simplefb 自己 ioremap_wc()，arm64 上属性不匹配。
 *
 * simpledrm 抢到 framebuffer 之后 msm 的显示驱动就绑不上了 —— 阶段 1 不需要它：
 * 判据是"能不能出字"和"能不能进 shell"，不是"能不能跑 Steam"。
 */
&{/chosen} {
	framebuffer@9c000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0x9c000000 0x0 0x9a3f80>;
		width = <1080>;
		height = <2340>;
		stride = <4320>;
		format = "a8r8g8b8";
	};
};

&{/reserved-memory} {
	splash_region: splash@9c000000 {
		reg = <0x0 0x9c000000 0x0 0x2400000>;
		no-map;
	};
};

/*
 * 崩溃日志的落点。
 *
 * 地址和分区大小不是挑的，是抄 Android 的：原厂内核的 cmdline 带
 * `ramoops_memreserve=4M`，ramoops 模块实际绑在
 *
 *     mem_address 0xB0000000   mem_size 4 MiB
 *     console_size 2 MiB       pmsg_size 2 MiB   ecc 0   dump_oops 1
 *
 * 照抄的好处是闭环：我们的内核崩了以后，这块 DRAM 里的内容不会被动，
 * 重启进 Android 时原厂内核的 ramoops 会按同样的布局把它读成
 * /sys/fs/pstore/console-ramoops-0 —— 那台机器上唯一一条能读到我们内核
 * 崩溃原因的路径（没有串口，USB 又还没起来）。
 *
 * 必须 no-map 预留：这段在我们 DTS 的低内存区间里，不预留内核会拿去用。
 */
&{/reserved-memory} {
	ramoops@b0000000 {
		compatible = "ramoops";
		reg = <0x0 0xb0000000 0x0 0x400000>;
		console-size = <0x200000>;
		pmsg-size = <0x200000>;
		no-map;
	};
};
