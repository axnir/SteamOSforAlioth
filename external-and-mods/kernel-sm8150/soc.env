# SM8150 (Snapdragon 855/855+): Xiaomi Redmi K20 Pro / Mi 9T Pro (raphael).
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.
#
# 和 kernel-sm8250 的区别不是参数，是结构：this device's support is in its own
# kernel tree, not in mainline 7.2.8 and not in ROCKNIX. So this recipe brings
# its own source (KSRC_URL), its own base config (KCONFIG_FRAGMENT) and its own
# DTS, and sets OWN_KERNEL_TREE=1, which tells build.sh to skip everything it
# would otherwise take from ROCKNIX (patches, DTS, config, extra-firmware,
# the chipone touch driver) instead of fetching them and failing later.

SOC=sm8150
KNAME=raphael
OWN_KERNEL_TREE=1

# GengWei1997/linux, branch raphael-v7.3.0 (7.3.0 + sm8150-xiaomi-raphael.dts
# + arch/arm64/configs/sm8150-xiaomi-raphael.config).
#
# Pinned by commit, not by branch name: a tarball of a branch is a different
# file tomorrow, and the whole point of the pin is that two builds of this
# commit produce the same kernel. 2026-11-06, raphael-v7.3.0 =
# 7f3a905f30d2d0878223c7ecc55b13a9d8bc1185.
#
# 这套板级文件是给 U-Boot/UEFI 引导写的：DTB 由引导器直接递进内核，所以它
# 没有 qcom,msm-id / qcom,board-id —— 而小米的 ABL 就靠这两个值选 DTB。补丁
# patches/0001 加的就是这两行，值和真机 /proc/device-tree 读出来的一致。
KVER=7.3.0
KSRC_URL="https://github.com/GengWei1997/linux/archive/7f3a905f30d2d0878223c7ecc55b13a9d8bc1185.tar.gz"
# 第一次构建后填这里（sha256sum 那份 tarball）。空着表示不校验，
# 但一个可复现的构建应该在校验通过与否上有答案。
KSRC_SHA256=""

# No ROCKNIX patch dirs: they are sm8250/ROCKNIX-ABL workarounds and do not
# apply to a 7.3.0 tree. Our own patches/ still applies (PORT_DIRS below).
PATCH_DIRS=""

# defconfig + this fragment (in the tree), instead of a full .config we would
# have to regenerate and commit on every kernel bump.
KCONFIG_FRAGMENT=arch/arm64/configs/sm8150-xiaomi-raphael.config

DTBS="sm8150-xiaomi-raphael"

# 机内固件（GPU zap、ADSP、modem、WCN3998 的 board-2.bin）都来自这台手机自己，
# 不可再分发，所以一个都不进内核镜像：FW_BUILTIN=0 让它们从 rootfs 加载。
# 这也意味着**阶段 1 的图像没有 GPU 和 WiFi** —— 阶段 1 只验证能不能出画面、
# 能不能进 shell，这两样都不需要它们。
FW_BUILTIN=0
BUILTIN_FW=""

CMDLINE_SOC="mem_sleep_default=s2idle"

# ABL 从 boot 分区取内核，cmdline 由我们打进镜像（build.sh 会 CMDLINE_FORCE），
# 因为小米的 ABL 会在我们给的参数后面再追加它自己的一串 Android 参数。
CMDLINE_BUILTIN=1
CMDLINE_ROOT=PARTLABEL=userdata

# initramfs 编进 Image（阶段 1 没有 rootfs，也没有 modprobe）。
EMBED_INITRAMFS=1

# 让 build.sh 把裸 Image 也留在输出里：make-steamos-raphael.sh 要用它和单个
# DTB 自己打 boot.img，打包参数按这台机器原厂 boot.img 的头部来（见
# docs/raphael.md §2.2），不用 ROCKNIX ABL 那一套。
KEEP_IMAGE=1

# 设备树来自设备自己的树，ROCKNIX 的 SM8250 DTS 一份都不要。
SKIP_ROCKNIX_DTS=1
