@@ -1578,8 +1578,26 @@
 	else
 		soc = bq27xxx_read(di, BQ27XXX_REG_SOC, false);
 
-	if (soc < 0)
+	if (soc < 0) {
 		dev_dbg(di->dev, "error reading State-of-Charge\n");
+		return soc;
+	}
+
+	/*
+	 * OnePlus 8 Pro 上那颗 bq27541（DeviceType() = 0x0421）的固件把
+	 * StateOfCharge() 报成 0.01 % 单位：3807 表示 38.07 %。上游按
+	 * 0-100 直接使用，power_supply 的 capacity 就变成 3807 %。
+	 *
+	 * 只有越界时才换算，正常报 0-100 的 gauge 完全不受影响；
+	 * 超过 10000 的值连 0.01 % 也解释不了，当作读数无效返回错误。
+	 */
+	if (soc > 100) {
+		if (soc > 10000) {
+			dev_dbg(di->dev, "implausible State-of-Charge %d\n", soc);
+			return -ENODATA;
+		}
+		soc = DIV_ROUND_CLOSEST(soc, 100);
+	}
 
 	return soc;
 }
