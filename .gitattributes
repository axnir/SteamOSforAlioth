# Keep GitHub language stats on this project's glue, not vendored trees.
external-and-mods/gamescope/** linguist-vendored
external-and-mods/BOX64/** linguist-vendored
external-and-mods/MangoHud/** linguist-vendored
external-and-mods/lsfg-vk/** linguist-vendored
external-and-mods/kernel/vendor/** linguist-vendored
external-and-mods/kernel/reference/** linguist-vendored
external-and-mods/kernel/device-tree/** linguist-vendored

# These three are consumed by Linux tools, not by Windows ones: the driver is
# compiled, the patch is fed to patch(1), the binding is parsed by dt-schema.
# core.autocrlf=true would hand them CRLF after a checkout, which patch(1)
# matches against the wrong lines and dt-schema rejects.
external-and-mods/kernel-sm8250/drivers/*.c   text eol=lf
external-and-mods/kernel-sm8250/patches/*.patch text eol=lf
external-and-mods/kernel-sm8250/bindings/*.yaml text eol=lf

# Same reason, one level up. A CRLF device tree still parses (dtc tolerates
# it) but every line moves, so a patch hunk that quotes it fails; and a CRLF
# steamos.config fails silently -- build.sh's `case "$val" in y)` never
# matches "y\r", so the option is dropped without a WARN. Both were observed
# on this tree before these two rules existed.
external-and-mods/kernel-sm8250/dts/*.dts     text eol=lf
external-and-mods/kernel-sm8250/*.config      text eol=lf

# Shell scripts run inside build containers, which mount this working tree.
# A CRLF checkout therefore hands `set -euo pipefail\r` to a Linux bash and
# every such script dies at line 1 with "invalid option name" -- that is
# exactly what happened to scripts/fetch-steamos-rootfs.sh while building
# the rootfs image on Windows.
*.sh                                          text eol=lf

# The overlay trees are consumed by Linux at runtime: shell scripts with no
# .sh suffix (gamescope-session, gamescope-onready, steamos-select-branch),
# systemd units, python helpers. core.autocrlf=true turns a checkout into
# CRLF, and every one of those failure modes was observed on the device:
#   - `#!/bin/bash\r` -> sddm-helper exits 126, the graphical session never runs
#   - python3 dies on the shebang ("gamescope-onready" 127, panel-modes 127)
#   - unit files get glued lines (`ConditionPathExists=...m1[Service]`)
# Keep both trees LF in the index *and* in the worktree, whatever the checkout
# side is configured to do.
steamos-overlay/**                            text eol=lf
op8p-overlay/**                               text eol=lf

# The attribute file itself is read by git on every checkout.
.gitattributes                                text eol=lf
